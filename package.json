{
  "name": "ITSM-test",
  "description": "Тестовое задание: Цифровая API визитка: TypeScript, Node.js, NestJS, Prisma, GraphQL и PostgreSQL",
  "author": "Daniil Egorov (https://github.com/Lambdius)",
  "version": "0.0.1",
  "main": "dist/src/main.js",
  "engines": {
    "node": "24.18.0"
  },
  "config": {
    "engine-strict": true
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm run generate && nest build",
    "lint": "eslint .",
    "lint:fix": "eslint --config ./prettier.config.mjs --fix --format json | node -e \"let input = ''; process.stdin.on('data', chunk => input += chunk); process.stdin.on('end', () => { const results = JSON.parse(input); results.forEach(file => { if (file.output) console.log(file.filePath); }); if (results.some(file => file.errorCount > 0)) process.exitCode = 1; });\"",
    "tsc": "tsc --noEmit",
    "knip": "knip --config configs/knip.config.ts",
    "env:check": "bash scripts/env.check.sh",
    "hooks:install": "bash scripts/hooks.install.sh",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "start": "node dist/src/main.js",
    "start:server": "node dist/src/main.js",
    "utest": "NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.unit.config.mjs",
    "itest": "NODE_OPTIONS='--import tsx --experimental-vm-modules' jest --config ./jest.integration.config.mjs",
    "test": "pnpm run utest && pnpm run itest",
    "coverage:unit": "pnpm run utest --coverage --coverageDirectory=coverage/unit",
    "coverage:integration": "pnpm run itest --coverage --coverageDirectory=coverage/integration",
    "coverage:all": "NODE_OPTIONS='--import tsx --experimental-vm-modules' jest --config ./jest.coverage.config.mjs --coverage"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/fastify": "3.1.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-fastify": "11.2.1",
    "@nestjs/terminus": "11.1.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.11.3",
    "graphql": "16.14.2",
    "ms": "2.1.3",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@apollo/gateway": "2.10.5",
    "@jest/globals": "30.4.1",
    "@nestjs/cli": "11.0.24",
    "@testcontainers/postgresql": "12.1.0",
    "@types/ms": "2.1.0",
    "@types/node": "24.13.3",
    "@types/ws": "7.4.7",
    "@typescript-eslint/parser": "8.67.0",
    "dotenv": "17.4.2",
    "eslint": "10.9.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "prisma-json-types-generator": "5.1.1",
    "ts-jest": "29.4.12",
    "ts-morph": "28.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
