# Images
SERVICE_NAME=profile-backend
APP_BASE_IMAGE=node:24.18.0-alpine
APP_IMAGE_TAG=local
POSTGRES_IMAGE=postgres:17-alpine

# Network
PUBLISHED_HOST=127.0.0.1
APP_PUBLISHED_PORT=3000
POSTGRES_PUBLISHED_PORT=55432
DOCKER_NETWORK_POSTGRES=profile-postgres-net

# PostgreSQL
POSTGRES_USER=profile
POSTGRES_PASSWORD=profile
POSTGRES_DB=profile
POSTGRES_PORT=5432
DATABASE_URL=postgresql://profile:profile@postgresql:5432/profile

# Application
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
BODY_LIMIT_BYTES=1048576
HSTS_MAX_AGE=365d
ALLOWED_SERVICE_ORIGINS=[]
ALLOWED_UI_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://itsm.lambdius.com"]

# Healthchecks
HEALTHCHECK_START_PERIOD=30s
HEALTHCHECK_INTERVAL=10s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10
