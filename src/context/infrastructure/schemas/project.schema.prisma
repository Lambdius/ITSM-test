model Project {
    createdAt DateTime  @map("created_at") @db.Timestamptz(3)
    updatedAt DateTime? @map("updated_at") @db.Timestamptz(3)

    id        String    @id @db.Uuid
    name      String    @db.Text
    url       String    @db.Text

    profile String  @map("profile_id") @db.Uuid
    owner   Profile @relation(fields: [profile], references: [id], onDelete: Cascade)

    @@index([profile])
    @@map("project")
}
